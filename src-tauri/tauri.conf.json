{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metrovpn",
  "version": "2.7.0",
  "identifier": "site.metrodens.metrovpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metrovpn",
        "width": 520,
        "height": 620,
        "minWidth": 520,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "tray",
        "url": "index.html?window=tray",
        "title": "Metrovpn Tray",
        "width": 320,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Metro Dens",
    "copyright": "Copyright (c) 2026 Metro Dens",
    "shortDescription": "Metrovpn Desktop — High-contrast Crimson Void VPN client powered by Xray-core",
    "longDescription": "Native Windows 11 VPN client powered by Xray-core v26.11.9 and Wintun (tun2socks), supporting System Proxy Mode, TUN Mode, Strict VCN, TLS Frag, DoH resolvers, Split Tunneling, concurrent node ping, and Cloudflare speed tests.",
    "externalBin": [
      "binaries/xray",
      "binaries/tun2socks"
    ],
    "resources": [
      "resources/wintun.dll",
      "resources/geoip.dat",
      "resources/geosite.dat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  }
}
