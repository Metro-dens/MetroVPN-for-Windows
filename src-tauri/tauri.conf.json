{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metrovpn",
  "version": "2.4.0",
  "identifier": "site.metrodens.metrovpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metrovpn",
        "width": 1040,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "tray",
        "url": "index.html?window=tray",
        "title": "Metrovpn Tray",
        "width": 320,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": [
      "binaries/xray",
      "binaries/tun2socks"
    ],
    "resources": [
      "resources/wintun.dll",
      "resources/geoip.dat",
      "resources/geosite.dat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  }
}
